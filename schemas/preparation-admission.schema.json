{
  "$defs": {
    "AcquisitionAdmission": {
      "additionalProperties": false,
      "properties": {
        "acquisition_version": {
          "maximum": 1,
          "minimum": 1,
          "title": "Acquisition Version",
          "type": "integer"
        },
        "provider": {
          "const": "huggingface",
          "title": "Provider",
          "type": "string"
        },
        "repo_id": {
          "title": "Repo Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        },
        "lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lock Sha256",
          "type": "string"
        },
        "allow_network": {
          "title": "Allow Network",
          "type": "boolean"
        },
        "decoder_profile": {
          "const": "scalar-parquet-v1",
          "title": "Decoder Profile",
          "type": "string"
        },
        "max_source_body_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Source Body Bytes",
          "type": "integer"
        },
        "max_metadata_body_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Metadata Body Bytes",
          "type": "integer"
        },
        "max_transfers": {
          "exclusiveMinimum": 0,
          "title": "Max Transfers",
          "type": "integer"
        },
        "max_requests": {
          "exclusiveMinimum": 0,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_retries_per_shard": {
          "minimum": 0,
          "title": "Max Retries Per Shard",
          "type": "integer"
        },
        "max_wall_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Wall Seconds",
          "type": "integer"
        },
        "max_cache_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Cache Bytes",
          "type": "integer"
        },
        "max_cache_files": {
          "exclusiveMinimum": 0,
          "title": "Max Cache Files",
          "type": "integer"
        },
        "max_scanned_rows": {
          "exclusiveMinimum": 0,
          "title": "Max Scanned Rows",
          "type": "integer"
        },
        "max_verification_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Verification Bytes",
          "type": "integer"
        },
        "max_observed_owned_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Observed Owned Bytes",
          "type": "integer"
        },
        "max_observed_owned_inodes": {
          "exclusiveMinimum": 0,
          "title": "Max Observed Owned Inodes",
          "type": "integer"
        },
        "require_hard_disk_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Require Hard Disk Bytes"
        },
        "require_hard_decoder_memory_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Require Hard Decoder Memory Bytes"
        },
        "require_expanded_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Require Expanded Bytes"
        }
      },
      "required": [
        "acquisition_version",
        "provider",
        "repo_id",
        "revision",
        "lock_sha256",
        "allow_network",
        "decoder_profile",
        "max_source_body_bytes",
        "max_metadata_body_bytes",
        "max_transfers",
        "max_requests",
        "max_retries_per_shard",
        "max_wall_seconds",
        "max_cache_bytes",
        "max_cache_files",
        "max_scanned_rows",
        "max_verification_bytes",
        "max_observed_owned_bytes",
        "max_observed_owned_inodes"
      ],
      "title": "AcquisitionAdmission",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reviewed_commit": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed Commit"
    },
    "reviewed_descriptor_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed Descriptor Sha256"
    },
    "recipe_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recipe Sha256",
      "type": "string"
    },
    "binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Binding Sha256",
      "type": "string"
    },
    "cpu_python": {
      "format": "path",
      "title": "Cpu Python",
      "type": "string"
    },
    "max_documents": {
      "exclusiveMinimum": 0,
      "title": "Max Documents",
      "type": "integer"
    },
    "max_tokens": {
      "exclusiveMinimum": 0,
      "title": "Max Tokens",
      "type": "integer"
    },
    "max_vocab_size": {
      "minimum": 260,
      "title": "Max Vocab Size",
      "type": "integer"
    },
    "min_free_bytes": {
      "exclusiveMinimum": 0,
      "title": "Min Free Bytes",
      "type": "integer"
    },
    "min_free_inodes": {
      "exclusiveMinimum": 0,
      "title": "Min Free Inodes",
      "type": "integer"
    },
    "max_snapshot_bytes": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Snapshot Bytes"
    },
    "max_snapshot_records": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Snapshot Records"
    },
    "acquisitions": {
      "additionalProperties": {
        "$ref": "#/$defs/AcquisitionAdmission"
      },
      "title": "Acquisitions",
      "type": "object"
    }
  },
  "required": [
    "recipe_sha256",
    "binding_sha256",
    "cpu_python",
    "max_documents",
    "max_tokens",
    "max_vocab_size",
    "min_free_bytes",
    "min_free_inodes"
  ],
  "title": "PreparationAdmission",
  "type": "object"
}
