        "kind",
        "plan"
      ],
      "title": "RuntimeAcceptance",
      "type": "object"
    },
    "SourcePassRequirement": {
      "additionalProperties": false,
      "description": "Maximum projected per-domain reuse of unique source material.\n\nOverlapping source documents across domains are counted once *per domain*;\nthese bounds do not describe train order or actual ingestion passes.",
      "properties": {
        "basis": {
          "enum": [
            "bytes",
            "tokens"
          ],
          "title": "Basis",
          "type": "string"
        },
        "max_required": {
          "exclusiveMinimum": 0,
          "title": "Max Required",
          "type": "integer"
        },
        "mixture": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Mixture",
          "type": "object"
        },
        "requested_total": {
          "exclusiveMinimum": 0,
          "title": "Requested Total",
          "type": "integer"
        }
      },
      "required": [
        "basis",
        "requested_total",
        "mixture",
        "max_required"
      ],
      "title": "SourcePassRequirement",
      "type": "object"
    },
    "TokenMeasurement": {
      "additionalProperties": false,
      "properties": {
        "corpus": {
          "title": "Corpus",
          "type": "string"
        },
