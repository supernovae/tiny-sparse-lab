  "additionalProperties": false,
  "properties": {
    "campaign_version": {
      "const": 1,
      "title": "Campaign Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "stages": {
      "items": {
        "discriminator": {
          "mapping": {
            "approval": "#/$defs/Approval",
            "artifact_reference": "#/$defs/ArtifactReference",
            "corpus_readiness": "#/$defs/CorpusReadiness",
            "corpus_release": "#/$defs/CorpusRelease",
            "evaluation": "#/$defs/Evaluation",
            "experiment_collect": "#/$defs/ExperimentCollect",
            "experiment_plan": "#/$defs/ExperimentPlanStage",
            "experiment_run": "#/$defs/ExperimentRun",
            "model_readiness": "#/$defs/ModelReadiness",
            "runtime_acceptance": "#/$defs/RuntimeAcceptance",
            "token_measurement": "#/$defs/TokenMeasurement",
            "tokenizer_reference": "#/$defs/TokenizerReference"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ArtifactReference"
          },
          {
            "$ref": "#/$defs/CorpusRelease"
          },
          {
            "$ref": "#/$defs/CorpusReadiness"
          },
          {
            "$ref": "#/$defs/TokenizerReference"
          },
          {
            "$ref": "#/$defs/TokenMeasurement"
          },
          {
            "$ref": "#/$defs/ExperimentPlanStage"
          },
          {
            "$ref": "#/$defs/RuntimeAcceptance"
          },
          {
            "$ref": "#/$defs/ExperimentRun"
          },
          {
            "$ref": "#/$defs/ExperimentCollect"
          },
          {
            "$ref": "#/$defs/Evaluation"
          },
          {
            "$ref": "#/$defs/ModelReadiness"
          },
          {
            "$ref": "#/$defs/Approval"
          }
        ]
      },
      "minItems": 1,
      "title": "Stages",
      "type": "array"
    }
  },
  "required": [
    "campaign_version",
    "id",
    "stages"
  ],
  "title": "CampaignPlan",
  "type": "object"
}
