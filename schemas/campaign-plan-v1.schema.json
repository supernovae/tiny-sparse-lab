    "ExperimentPlanStage": {
      "additionalProperties": false,
      "properties": {
        "corpus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corpus"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "experiment_plan",
          "title": "Kind",
