{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "bind": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Bind",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "approval",
          "title": "Kind",
          "type": "string"
        },
        "requires": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "scope": {
          "enum": [
            "release",
            "model"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
        "kind",
        "bind"
      ],
      "title": "Approval",
      "type": "object"
    },
    "Artifact": {
      "additionalProperties": false,
      "description": "An external immutable identity, or a named future producer (not both).",
      "properties": {
        "from_phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Phase"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source_snapshot",
            "corpus_build",
            "corpus_release",
            "corpus_export",
            "tokenizer",
            "prepared_data",
            "stage_bundle",
            "checkpoint",
            "capability_card",
            "prompt_set",
            "outcome"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "selector": {
          "anyOf": [
            {
              "enum": [
                "terminal",
                "best_validation"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selector"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "full",
                "weights"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "version",
        "producer",
        "identifier"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/Artifact"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "artifact_reference",
          "title": "Kind",
          "type": "string"
        },
        "requires": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "scope": {
          "enum": [
            "corpus",
            "tokenizer",
            "model",
            "runtime",
            "evaluation",
            "release"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
        "kind",
        "artifact"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "CorpusReadiness": {
      "additionalProperties": false,
      "properties": {
        "corpus": {
          "title": "Corpus",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "corpus_readiness",
          "title": "Kind",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/CorpusReadinessPolicy"
        },
        "requires": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "scope": {
          "const": "corpus",
          "title": "Scope",
          "type": "string"
        },
        "tokenizer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokenizer"
        }
      },
      "required": [
        "id",
        "scope",
        "kind",
        "corpus",
        "policy"
      ],
      "title": "CorpusReadiness",
      "type": "object"
    },
    "CorpusReadinessPolicy": {
      "additionalProperties": false,
      "description": "Authored minima, independent of the frozen release's mixture.",
      "properties": {
        "min_heldout_families": {
          "default": 0,
          "minimum": 0,
          "title": "Min Heldout Families",
          "type": "integer"
        },
        "min_unique_train_bytes_by_domain": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Min Unique Train Bytes By Domain",
          "type": "object"
        },
        "min_unique_train_tokens_by_domain": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Min Unique Train Tokens By Domain",
          "type": "object"
        },
        "passes": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourcePassRequirement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required_nonzero_languages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Nonzero Languages",
          "type": "array"
        },
        "required_nonzero_shapes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Nonzero Shapes",
          "type": "array"
        }
      },
      "title": "CorpusReadinessPolicy",
      "type": "object"
    },
    "CorpusRelease": {
      "additionalProperties": false,
