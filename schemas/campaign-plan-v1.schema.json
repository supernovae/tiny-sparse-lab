    "TokenizerReference": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/Artifact"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "tokenizer_reference",
          "title": "Kind",
          "type": "string"
