        },
        "lock": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lock"
        },
        "mode": {
          "enum": [
            "lock",
            "reference"
          ],
          "title": "Mode",
          "type": "string"
        },
        "prepared": {
          "title": "Prepared",
          "type": "string"
        },
        "requires": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "scope": {
          "const": "model",
          "title": "Scope",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "tokenizer": {
          "title": "Tokenizer",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
