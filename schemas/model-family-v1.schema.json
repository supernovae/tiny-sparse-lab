{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "exclusiveMinimum": 0,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        }
      },
      "required": [
        "max_steps",
        "max_tokens"
      ],
      "title": "Budget",
      "type": "object"
    },
    "FamilyNode": {
      "additionalProperties": false,
      "properties": {
        "architecture_sha256": {
          "title": "Architecture Sha256",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocatedDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "corpus": {
          "$ref": "#/$defs/Identity"
        },
        "evaluation_index": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocatedDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "lifecycle_receipts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Lifecycle Receipts",
          "type": "array"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "parent_checkpoint_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Checkpoint Sha256"
        },
        "plan": {
          "$ref": "#/$defs/Identity"
        },
        "readiness_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocatedDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery_manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recovery Manifest"
        },
        "tokenizer": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "id",
        "parent",
        "parent_checkpoint_sha256",
        "corpus",
        "tokenizer",
        "plan",
        "architecture_sha256",
        "objective",
        "budget",
        "checkpoint",
        "evaluation_index",
        "readiness_result"
      ],
      "title": "FamilyNode",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "Identity",
      "type": "object"
    },
    "LocatedDigest": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "path"
      ],
      "title": "LocatedDigest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "family_version": {
      "const": 1,
      "title": "Family Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/FamilyNode"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    }
  },
  "required": [
    "family_version",
    "id",
    "nodes"
  ],
  "title": "FamilyManifest",
  "type": "object"
}
