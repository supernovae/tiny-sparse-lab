{
  "$defs": {
    "WorkflowLimits": {
      "additionalProperties": false,
      "description": "Declared ceilings, not allocation or an operating-system resource quota.",
      "properties": {
        "max_training_updates": {
          "exclusiveMinimum": 0,
          "title": "Max Training Updates",
          "type": "integer"
        },
        "max_target_positions": {
          "exclusiveMinimum": 0,
          "title": "Max Target Positions",
          "type": "integer"
        },
        "max_eval_batches": {
          "exclusiveMinimum": 0,
          "title": "Max Eval Batches",
          "type": "integer"
        }
      },
      "required": [
        "max_training_updates",
        "max_target_positions",
        "max_eval_batches"
      ],
      "title": "WorkflowLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reviewed_commit": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed Commit"
    },
    "reviewed_descriptor_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed Descriptor Sha256"
    },
    "recipe_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Recipe Sha256",
      "type": "string"
    },
    "binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Binding Sha256",
      "type": "string"
    },
    "cpu_python": {
      "format": "path",
      "title": "Cpu Python",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/WorkflowLimits"
    }
  },
  "required": [
    "recipe_sha256",
    "binding_sha256",
    "cpu_python",
    "limits"
  ],
  "title": "WorkflowAdmission",
  "type": "object"
}
