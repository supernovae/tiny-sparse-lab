{
  "$defs": {
    "LossCriterion": {
      "additionalProperties": false,
      "properties": {
        "evaluation_id": {
          "title": "Evaluation Id",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "evaluation_id",
        "value"
      ],
      "title": "LossCriterion",
      "type": "object"
    },
    "ReviewedScoreCriterion": {
      "additionalProperties": false,
      "description": "Predeclared item and formatting thresholds for independent panel review.",
      "properties": {
        "expected_axes": {
          "exclusiveMinimum": 0,
          "title": "Expected Axes",
          "type": "integer"
        },
        "expected_items": {
          "exclusiveMinimum": 0,
          "title": "Expected Items",
          "type": "integer"
        },
        "frozen_content_sha256": {
          "title": "Frozen Content Sha256",
          "type": "string"
        },
        "items_per_axis": {
          "exclusiveMinimum": 0,
          "title": "Items Per Axis",
          "type": "integer"
        },
        "min_axis_correct": {
          "minimum": 0,
          "title": "Min Axis Correct",
          "type": "integer"
        },
        "min_axis_format": {
          "minimum": 0,
          "title": "Min Axis Format",
          "type": "integer"
        },
        "min_correct": {
          "minimum": 0,
          "title": "Min Correct",
          "type": "integer"
        },
        "min_format": {
          "minimum": 0,
          "title": "Min Format",
          "type": "integer"
        }
      },
      "required": [
        "frozen_content_sha256",
        "expected_items",
        "expected_axes",
        "items_per_axis",
        "min_correct",
        "min_axis_correct",
        "min_format",
        "min_axis_format"
      ],
      "title": "ReviewedScoreCriterion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "max_heldout_loss": {
      "anyOf": [
        {
          "$ref": "#/$defs/LossCriterion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "min_completed_evaluations": {
      "exclusiveMinimum": 0,
      "title": "Min Completed Evaluations",
      "type": "integer"
    },
    "readiness_version": {
      "const": 1,
      "title": "Readiness Version",
      "type": "integer"
    },
    "require_human_review": {
      "title": "Require Human Review",
      "type": "boolean"
    },
    "require_verified_checkpoint": {
      "const": true,
      "title": "Require Verified Checkpoint",
      "type": "boolean"
    },
    "required_gate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Required Gate Ids",
      "type": "array"
    },
    "reviewed_scores": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewedScoreCriterion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "readiness_version",
    "id",
    "require_verified_checkpoint",
    "required_gate_ids",
    "min_completed_evaluations",
    "require_human_review"
  ],
  "title": "ModelReadinessPolicy",
  "type": "object"
}
